@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">
    <h2>Delete Event</h2>
    <h3 class="text-danger">Are you sure you want to delete this event?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2 fw-bold">Title</dt>
            <dd class="col-sm-10">@Model.Title</dd>

            <dt class="col-sm-2 fw-bold">Description</dt>
            <dd class="col-sm-10">@Model.Description</dd>

            <dt class="col-sm-2 fw-bold">Date & Time</dt>
            <dd class="col-sm-10">@Model.EventDate</dd>

            <dt class="col-sm-2 fw-bold">Location</dt>
            <dd class="col-sm-10">@Model.Location</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Confirm Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </form>
    </div>
</div>