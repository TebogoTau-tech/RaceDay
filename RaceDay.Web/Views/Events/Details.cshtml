@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title text-primary mb-3">@Model.Title</h2>
                    <h6 class="card-subtitle mb-3 text-muted"><strong>Location:</strong> @Model.Location</h6>
                    <p class="card-text"><strong>Date & Time:</strong> @Model.EventDate.ToString("yyyy-MM-dd HH:mm")</p>
                    <hr />
                    <p class="card-text"><strong>Description:</strong></p>
                    <p class="card-text bg-light p-3 rounded">@Model.Description</p>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-3">
                            <label class="fw-bold d-block">Event Banner:</label>
                            <img src="@Model.ImageUrl" alt="Event Banner" class="img-fluid rounded shadow-sm" style="max-height: 300px;" />
                        </div>
                    }
                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>